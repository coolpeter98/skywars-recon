return {
	["shallowEqual"] = function(p1, p2) -- name: shallowEqual
		if p1 == p2 then
			return true
		end
		if p1 == nil or p2 == nil then
			return false
		end
		for v3, v4 in pairs(p1) do
			if p2[v3] ~= v4 then
				return false
			end
		end
		for v5, v6 in pairs(p2) do
			if p1[v5] ~= v6 then
				return false
			end
		end
		return true
	end
}