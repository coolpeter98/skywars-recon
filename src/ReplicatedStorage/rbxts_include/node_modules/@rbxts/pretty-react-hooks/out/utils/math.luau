return {
	["lerp"] = function(p1, p2, p3) -- name: lerp
		return p1 + (p2 - p1) * p3
	end,
	["map"] = function(p4, p5, p6, p7, p8) -- name: map
		return (p4 - p5) * (p8 - p7) / (p6 - p5) + p7
	end,
	["blend"] = function(...) -- name: blend
		local v9 = 1
		for _, v10 in { ... } do
			v9 = v9 * (1 - v10)
		end
		return 1 - v9
	end
}